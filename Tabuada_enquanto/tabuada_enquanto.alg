Algoritmo "Tabuada Personalizada"

Var
   N,contador,resultado:Inteiro


Inicio

   Escreva("Escreva um numero de 1 a 10: ")
   leia(N)

   Contador <- 1

   Enquanto (contador <=10) faca
      resultado <- N * contador

      Escreval(N, "x", contador, "=",resultado)

      contador <- contador+1

   FimEnquanto


Fimalgoritmo
