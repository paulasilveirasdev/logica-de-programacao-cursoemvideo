Algoritmo "Par ou Impar Procedimento"

Var
   N:inteiro

Procedimento parouimpar(V:Inteiro)
Inicio
   Se (V%2=0)entao
      Escreval(" O numero", V , " e PAR")
   Senao
      Escreval("O numero", V," e Impar")
   FimSE
   
FimProcedimento

Inicio
   Escreva("Informe um numero: ")
   leia(N)
   parouimpar(N)


Fimalgoritmo
